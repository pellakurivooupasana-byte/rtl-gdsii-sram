module tb_programmable_sram_controller;

    reg clk;
    reg rst_n;

    reg [7:0] addr;
    reg [7:0] data_in;
    wire [7:0] data_out;

    reg we;
    reg re;
    reg [7:0] password;

    wire access_denied;
    wire power_save_mode;

    // DUT Instantiation
    sram_controller uut (
        .clk(clk),
        .rst_n(rst_n),
        .addr(addr),
        .data_in(data_in),
        .data_out(data_out),
        .we(we),
        .re(re),
        .password(password),
        .access_denied(access_denied),
        .power_save_mode(power_save_mode)
    );

    // Clock Generation
    always #5 clk = ~clk;

    initial begin
        // Initialization
        clk = 0;
        rst_n = 0;
        addr = 0;
        data_in = 0;
        we = 0;
        re = 0;
        password = 8'h00;

        // Reset
        #10 rst_n = 1;

        //--------------------------------------------------
        // Correct Password
        //--------------------------------------------------
        #10 password = 8'hA5;

        //--------------------------------------------------
        // Write Operation
        //--------------------------------------------------
        #10;
        addr = 8'd10;
        data_in = 8'hAA;
        we = 1;

        #10;
        we = 0;

        //--------------------------------------------------
        // Read Operation
        //--------------------------------------------------
        #10;
        addr = 8'd10;
        re = 1;

        #10;
        re = 0;

        if (data_out == 8'hAA)
            $display("WRITE/READ PASS : Data = %h", data_out);
        else
            $display("WRITE/READ FAIL : Data = %h", data_out);

    
        // Second Write and Read
     
        #10;
        addr = 8'd20;
        data_in = 8'h55;
        we = 1;

        #10;
        we = 0;

        #10;
        addr = 8'd20;
        re = 1;

        #10;
        re = 0;

        if (data_out == 8'h55)
            $display("SECOND TEST PASS : Data = %h", data_out);
        else
            $display("SECOND TEST FAIL : Data = %h", data_out);

       
        // Wrong Password Test
       
        #10;
        password = 8'hFF;

        addr = 8'd30;
        data_in = 8'h99;
        we = 1;

        #10;
        we = 0;

        if (access_denied)
            $display("ACCESS DENIED TEST PASS");

     
        // Power Save Test
     
        #20;

        if (power_save_mode)
            $display("POWER SAVE MODE ENABLED");

        #50;
        $finish;
    end

endmodule
